---
import { brand, guides, proof, voice, cta } from "../../data/site";

const chain = [
	{
		id: "build",
		step: "01",
		label: "Build",
		note: "Laravel, PHP, Vue, and React applications — packages and products meant to be reused, not redrawn every quarter.",
	},
	{
		id: "market",
		step: "02",
		label: "Market",
		note: "Growth, SEO, and paid channels as part of the craft — so the product finds an audience after it ships.",
	},
	{
		id: "ship",
		step: "03",
		label: "Ship",
		tone: "accent",
		note: "Live products and open-source packages leave the lab. Audience work includes co-founding Saturday Down South.",
	},
	{
		id: "experiment",
		step: "04",
		label: "Experiment",
		note: "Solidity, ERC-20 standards, EVM tooling, and drewroberts.eth — Web3 without the costume.",
	},
	{
		id: "repeat",
		step: "05",
		label: "Repeat",
		tone: "light",
		note: "Build. Ship. Break. Repeat. Good ideas compound — for clients and collaborators alike.",
	},
];
---

<header class="about-hero">
	<div class="about-hero__copy">
		<p class="archive__eyebrow"><span class="archive__mark" aria-hidden="true"></span>Archive / About</p>
		<h2 class="archive__title about-hero__title">
			<span>Digital</span>
			<span class="about-hero__outline">Craftsman</span>
		</h2>
		<p class="archive__lede about-hero__lede">{voice.bio}</p>
		<p class="about-hero__hint">{brand.availability}</p>
	</div>

	<div
		class="action-stage"
		data-accent
		data-accent-mode="cascade"
		aria-label="Chain of Action plates tipping in sequence"
	>
		<div class="action-stage__chrome" aria-hidden="true">
			<span>Action chain</span>
			<span>01 → 05</span>
		</div>
		{
			chain.map((item) => (
				<div
					class:list={[
						"accent-body",
						"action-slab",
						item.tone === "accent" && "action-slab--accent",
						item.tone === "light" && "action-slab--light",
					]}
					data-accent-body={item.id}
				>
					<span class="action-slab__step">{item.step}</span>
					<span class="action-slab__label">{item.label}</span>
				</div>
			))
		}
		<div class="action-stage__floor" aria-hidden="true">
			<span>Build · Market · Ship · Experiment · Repeat</span>
		</div>
	</div>
</header>

<div class="about-grid">
	<p class="about-grid__kicker">Chain of action</p>
	<ol class="chain">
		{
			chain.map((item) => (
				<li class="chain__item">
					<span class="chain__step">{item.step}</span>
					<div>
						<h3 class="chain__label">{item.label}</h3>
						<p class="chain__note">{item.note}</p>
					</div>
				</li>
			))
		}
	</ol>

	<aside class="about-facts" aria-label="Studio notes">
		{
			proof.map((item, i) => (
				<div class:list={["about-fact", { "about-fact--accent": i === proof.length - 1 }]}>
					<span class="about-fact__label">{item.label}</span>
					<span class="about-fact__value">{item.value}</span>
				</div>
			))
		}
		<p class="about-facts__note">
			Samford University · GitHub under drewroberts and roberts · {brand.availability}.
		</p>
		<a class="about-facts__cta" href={cta.bookHref}
			>{cta.bookLabel} <span aria-hidden="true">↗</span></a
		>
	</aside>
</div>

<section class="guides" aria-labelledby="guides-title">
	<div class="guides__head">
		<p class="archive__eyebrow"><span class="archive__mark" aria-hidden="true"></span>How we work</p>
		<h3 class="guides__title" id="guides-title">Guides</h3>
	</div>
	<div class="guides__grid">
		{
			guides.map((guide) => (
				<article class="guide">
					<p class="guide__for">{guide.for}</p>
					<h4 class="guide__name">{guide.title}</h4>
					<p class="guide__blurb">{guide.blurb}</p>
					<ul class="guide__points">
						{guide.points.map((point) => (
							<li>{point}</li>
						))}
					</ul>
				</article>
			))
		}
	</div>
</section>
