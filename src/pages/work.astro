---
import Layout from "../layouts/Layout.astro";
import { specimens } from "../data/specimens";
import { brand, cta } from "../data/site";

const chainPieces = [
	{ id: "eth", label: "Ξ", kind: "glyph", tone: "accent" },
	{ id: "evm", label: "EVM", kind: "tag" },
	{ id: "sol", label: "Solidity", kind: "tag" },
	{ id: "erc", label: "ERC-20", kind: "tag", tone: "light" },
	{ id: "ens", label: "ENS", kind: "tag" },
	{ id: "oss", label: "Open Source", kind: "tag" },
];
---

<Layout
	title="Work"
	description={`Selected software and open-source specimens from ${brand.name} — Laravel packages, Web3 tooling, and growth systems.`}
>
	<header class="work-hero">
		<div class="work-hero__copy">
			<p class="archive__eyebrow"><span class="archive__mark" aria-hidden="true"></span>Archive / Work</p>
			<h1 class="archive__title">Specimens</h1>
			<p class="archive__lede work-hero__lede">
				Public packages and standards from the bench — the kind of software a craftsperson ships for
				clients and collaborators alike.
			</p>
			<p class="work-hero__hint">
				<a href={cta.bookHref}>{cta.bookLabel}</a>
				<span aria-hidden="true"> · </span>
				{brand.availability}
			</p>
		</div>

		<div
			class="chain-bench"
			data-accent
			data-accent-mode="play"
			aria-label="Interactive blockchain tags. Drag them."
		>
			<div class="chain-bench__rail" aria-hidden="true">
				<span>Chain shelf</span>
				<span>01 — Web3</span>
			</div>
			{
				chainPieces.map((piece) =>
					piece.kind === "glyph" ? (
						<div
							class:list={["accent-body", "chain-glyph", { "chain-glyph--accent": piece.tone === "accent" }]}
							data-accent-body={piece.id}
						>
							{piece.label}
						</div>
					) : (
						<div
							class:list={[
								"accent-body",
								"accent-tag",
								piece.tone === "light" && "accent-tag--light",
								piece.tone === "accent" && "accent-tag--accent",
							]}
							data-accent-body={piece.id}
						>
							<span class="accent-tag__hole" />
							{piece.label}
						</div>
					),
				)
			}
		</div>
	</header>

	<div class="archive__rule"></div>

	<div class="specimen-grid" data-specimen-grid>
		{
			specimens.map((item) => (
				<a
					class:list={["specimen", { "specimen--quiet": item.quiet }]}
					href={item.href}
					target="_blank"
					rel="noopener noreferrer"
					data-specimen
				>
					<span class="specimen__shine" aria-hidden="true" />
					<span class="specimen__index">
						{item.index} / {String(specimens.length).padStart(2, "0")}
					</span>
					<h2 class="specimen__title">{item.title}</h2>
					<p class="specimen__blurb">{item.blurb}</p>
					<div class="specimen__meta">
						{item.tags.map((tag) => (
							<span class="specimen__tag">{tag}</span>
						))}
					</div>
					<span class="specimen__go">
						View on GitHub <span aria-hidden="true">↗</span>
					</span>
				</a>
			))
		}
	</div>
</Layout>

<script>
	import { mountAccent } from "../scripts/physics/accent";

	const root = document.querySelector<HTMLElement>("[data-accent]");
	if (root) {
		const accent = mountAccent({
			root,
			mode: "play",
			delay: 160,
		});
		document.addEventListener("astro:before-swap", () => accent.destroy(), { once: true });
	}

	const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
	if (!reduce) {
		document.querySelectorAll<HTMLElement>("[data-specimen]").forEach((card) => {
			const shine = card.querySelector<HTMLElement>(".specimen__shine");
			card.addEventListener("pointermove", (e) => {
				const r = card.getBoundingClientRect();
				const x = (e.clientX - r.left) / r.width - 0.5;
				const y = (e.clientY - r.top) / r.height - 0.5;
				card.style.setProperty("--tilt-x", `${(-y * 5).toFixed(2)}deg`);
				card.style.setProperty("--tilt-y", `${(x * 6).toFixed(2)}deg`);
				card.style.setProperty("--lift", "8px");
				if (shine) {
					shine.style.setProperty("--mx", `${((x + 0.5) * 100).toFixed(1)}%`);
					shine.style.setProperty("--my", `${((y + 0.5) * 100).toFixed(1)}%`);
				}
			});
			card.addEventListener("pointerleave", () => {
				card.style.setProperty("--tilt-x", "0deg");
				card.style.setProperty("--tilt-y", "0deg");
				card.style.setProperty("--lift", "0px");
			});
			card.addEventListener("pointerdown", () => {
				card.style.setProperty("--press", "0.985");
			});
			card.addEventListener("pointerup", () => {
				card.style.setProperty("--press", "1");
			});
		});
	}
</script>
